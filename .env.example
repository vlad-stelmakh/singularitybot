# === Telegram ===
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Соответствие Telegram user ID и ключей Singularity API. Только указанные
# пользователи получают доступ к боту. Формат: telegramId:apiKey,telegramId:apiKey
# Например: TELEGRAM_SINGULARITY_TOKENS=123456789:api-key-1,987654321:api-key-2
TELEGRAM_SINGULARITY_TOKENS=

# === OpenAI ===
OPENAI_API_KEY=
# (необязательно) свой базовый URL, если используется прокси/шлюз
# OPENAI_BASE_URL=
# Модель для диалога и вызова инструментов (нужна поддержка function calling + vision)
OPENAI_CHAT_MODEL=gpt-4o
# reasoning_effort для reasoning-моделей (gpt-5.x и т.п.).
# Оставьте пустым для авто: для gpt-5.x подставится "none" (иначе OpenAI не даёт
# сочетать function tools с reasoning в /v1/chat/completions). Возможные значения:
# none | low | medium | high (для моделей с tools в chat.completions нужен none).
# OPENAI_REASONING_EFFORT=none
# Модель для расшифровки голосовых сообщений
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# === Singularity API / MCP ===
SINGULARITY_BASE_URL=https://api.singularity-app.com
# Для совместимости со старой конфигурацией можно использовать обе переменные:
# ALLOWED_USER_IDS=123456789,987654321
# SINGULARITY_ACCESS_TOKEN=shared-api-key
# При заданной TELEGRAM_SINGULARITY_TOKENS эти переменные игнорируются.
# (необязательно) путь до запускаемого MCP-сервера, по умолчанию ./mcp.js
# MCP_ENTRY_POINT=

# === Прочее ===
# Часовой пояс владельца для дат/времени задач (формат смещения от UTC)
OWNER_TIMEZONE=+03:00
# Лимит итераций вызова инструментов за один запрос
MAX_TOOL_ITERATIONS=12
# Сколько последних сообщений диалога хранить в памяти на чат
MAX_HISTORY_MESSAGES=40
